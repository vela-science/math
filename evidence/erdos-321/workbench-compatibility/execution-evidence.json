        {
          "content": "{\n  \"schema\": \"vela.target-packet.v1\",\n  \"authority_effect\": \"none\",\n  \"authorship\": {\n    \"scientific_content\": \"experiment_operator\",\n    \"buzz_role\": \"transport_storage_and_readback_only\"\n  },\n  \"problem\": {\n    \"source\": \"erdos\",\n    \"native_id\": \"321\"\n  },\n  \"repository\": {\n    \"url\": \"https://github.com/vela-science/math.git\",\n    \"commit\": \"fab1c3ea6f342a491d5fdfd57fa1126970fb6e61\",\n    \"tree\": \"2668ca4c7ba345d43bc54ec951b818b469113e98\",\n    \"repository_id\": \"8115c538-7688-40b7-ab75-3c4765bf3c19\",\n    \"repository_root\": \"sha256:db4d435c2989d43c7ab88fe135865e89a6ba095429315baedb78bcbd9e90ebdc\"\n  },\n  \"current_standing\": {\n    \"claim_id\": \"vcl_3d4fd59554ccaa2b792b08abae16a8d0fe329d4901ad798fe05c6c7769c9966b\",\n    \"claim_root\": \"sha256:d5d77e7d96e390e0bf692d0abd44367eb06a0c6a61534e1c6654962d6c644776\",\n    \"standing\": \"accepted\",\n    \"assertion\": \"The Lean development starfleet/erdos-321 establishes a two-sided asymptotic bound on extremalSize, which denotes the same quantity as Formal Conjectures' Erdos321.R at pages commit 59f30aa3, and which therefore supplies a candidate answer for erdos_321.variants.isTheta rather than a proof of it.\"\n  },\n  \"evidence\": {\n    \"path\": \"evidence/erdos-321/terminal-variants\",\n    \"bundle_root\": \"sha256:bd7b7eee6eb5e2e8f654898207bf05168ea6e7dd1d72f3a1a46a685a64f8f322\",\n    \"source_lock_root\": \"sha256:128edd2b0b58597ca05c7c0049ab20c10c9e6ef4e06c2c3ff8371752123a103b\",\n    \"comparison_root\": \"sha256:808c9ba973d36b0ed79366ae04357c04e2c5b2c0aa5a04967f90ad09eabba699\"\n  },\n  \"obligation\": \"Construct and kernel-check explicit bridges between the real-log terminal coordinates and each Nat.log fixed-variant hypothesis before asserting implication.\",\n  \"completion_contract\": {\n    \"required\": [\n      \"A source patch rooted to the exact repository commit above\",\n      \"A network-independent command that checks the proposed Lean bridge\",\n      \"A machine-readable result manifest containing exact input and output roots\",\n      \"Explicit nonclaims for any implication or equivalence not kernel-checked\"\n    ],\n    \"forbidden\": [\n      \"Changing the accepted Claim or Repository Standing\",\n      \"Treating workbench activity or execution success as Verification\",\n      \"Using participant, evaluator, or private-build StandingBench inputs\",\n      \"Accessing Repository authority keys\"\n    ]\n  },\n  \"expected_return\": {\n    \"media_type\": \"application/json\",\n    \"schema\": \"vela.workbench-result.v1\",\n    \"maximum_bytes\": 65536,\n    \"required_fields\": [\n      \"workbench\",\n      \"packet_root\",\n      \"activity_event_ids\",\n      \"result_status\",\n      \"artifact_roots\",\n      \"nonclaims\"\n    ]\n  },\n  \"nonclaims\": [\n    \"The target packet is not a Vela protocol object.\",\n    \"The experiment operator authored this packet; Buzz performs no scientific reasoning over it.\",\n    \"A Buzz event signature authenticates workspace activity, not scientific truth.\",\n    \"A returned candidate is not a Verification Record, Decision, Event, or Standing.\"\n  ],\n  \"packet_root_definition\": \"sha256 of RFC 8785 canonical JSON with packet_root omitted\",\n  \"packet_root\": \"sha256:62004075572072cb96ccdf3f869ad3cf261d1abd39e826624d49b026dd57d92d\"\n}\n",

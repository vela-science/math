TRIBUTING.md:108:[elan, lake, and Lean](https://leanprover-community.github.io/get_started.html),\nREADME.md:50:[install elan, lake, lean and if you want vscode](https://leanprover-community.github.io/get_started.html)\n.github/workflows/build-and-docs.yml:109:      - name: Install elan\n.github/workflows/build-and-docs.yml:113:          curl -sSfL https://github.com/leanprover/elan/releases/download/v1.4.2/elan-x86_64-unknown-linux-gnu.tar.gz | tar xz\n.github/workflows/build-and-docs.yml:114:          ./elan-init -y --default-toolchain none\n.github/workflows/build-and-docs.yml:115:          echo \"$HOME/.elan/bin\" >> $GITHUB_PATH\n.github/workflows/build-and-docs.yml:149:          lake --wfail build FormalConjecturesForMathlib FormalConjecturesUtil\n.github/workflows/build-and-docs.yml:150:          lake --wfail test\n.github/workflows/build-and-docs.yml:155:          lake --wfail build\n","exit_code":0,"status":"completed"}}

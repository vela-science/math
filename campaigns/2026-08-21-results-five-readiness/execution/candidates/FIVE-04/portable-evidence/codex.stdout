eft_iff]\nHEAD:FormalConjecturesForMathlib/Combinatorics/SimpleGraph/Johnson.lean:56:lemma not_johnson_adj_iff_lt {s t : {s : Finset (Fin n) // #s = k}} :\nHEAD:FormalConjecturesForMathlib/Combinatorics/SimpleGraph/Johnson.lean:57:    ¬ J(n, k).Adj s t ↔ s = t ∨ #(s.val ∩ t.val) + 1 < k := by simp [johnson_adj_iff_ge]; tauto\nHEAD:FormalConjectures/ErdosProblems/835.lean:98:lemma indepNum_johnson_le_johnsonBound : α(J(n, k)) ≤ johnsonBound n 4 k := sorry\nHEAD:FormalConjectures/ErdosProblems/835.lean:102:lemma div_johnsonBound_le_chromaticNum_johnson :\nHEAD:FormalConjectures/ErdosProblems/835.lean:108:  grw [← card_div_indepNum_le_chromaticNumber, indepNum_johnson_le_johnsonBound] <;> simp\nHEAD:FormalConjectures/ErdosProblems/835.lean:120:theorem chromaticNumber_johnson_2k_k_lower_bound_odd (hk : 3 ≤ k) (hk' : k ≤ 300) (hk_odd : Odd k) :\nHEAD:FormalConjectures/ErdosProblems/835.lean:122:  grw [← div_johnsonBound_le_chromaticNum_johnson]\nHEAD:FormalConjectures/ErdosProblems/835.lean:129:theorem johnson_chromaticNumber_odd (k : ℕ) (hk : 2 < k) (h : Odd k) :\nHEAD:FormalConjectures/ErdosProblems/835.lean:138:theorem johnson_chromaticNumber_composite (k : ℕ) (hk : 2 < k) (h : (k + 1).Composite) :\nHEAD:FormalConjectures/ErdosProblems/835.lean:146:theorem johnsonGraph_chromaticNumber_odd_of_johnson_chromaticNumber_composite :\nHEAD:FormalConjectures/ErdosProblems/835.lean:147:    (type_of% johnson_chromaticNumber_composite) → (type_of% johnson_chromaticNumber_odd) := by\n{\"version\": \"1.1.0\",\n \"packagesDir\": \".lake/packages\",\n \"packages\":\n [{\"url\": \"https://github.com/leanprover-community/mathlib4\",\n   \"type\": \"git\",\n   \"subDir\": null,\n   \"scope\": \"leanprover-community\",\n   \"rev\": \"a3a10db0e9d66acbebf76c5e6a135066525ac900\",\n   \"name\": \"mathlib\",\n   \"manifestFile\": \"lake-manifest.json\",\n   \"inputRev\": \"v4.27.0\",\n   \"inherited\": false,\n   \"configFile\": \"lakefile.lean\"},\n  {\"url\": \"https://github.com/leanprove